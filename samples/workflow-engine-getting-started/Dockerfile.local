# Local-only build: compiles the native binary against the in-repo SDK
# checkout (composite build) instead of a published GitHub Packages artifact.
#
# MUST be built with the kaleido-sdk-java repo root as context:
#   cd kaleido-sdk-java &&
#   docker build -f samples/workflow-engine-getting-started/Dockerfile.local -t <tag> .
FROM ghcr.io/graalvm/native-image-community:21 AS builder

# Gradle wrapper script requires xargs.
RUN microdnf install -y findutils && microdnf clean all

WORKDIR /build
COPY . .

WORKDIR /build/samples/workflow-engine-getting-started
RUN ./gradlew --no-daemon -PsdkIncludeBuild=true nativeCompile

FROM gcr.io/distroless/base-debian12
WORKDIR /app

# Include libz from the builder image
COPY --from=builder /usr/lib64/libz.so.1 /usr/lib/libz.so.1

COPY --from=builder /build/samples/workflow-engine-getting-started/build/native/nativeCompile/provider /app/provider
COPY --from=builder /build/samples/workflow-engine-getting-started/src/main/resources/kaleido-config.yaml /config/kaleido-config.yaml

ENV KALEIDO_CONFIG_FILE=/config/kaleido-config.yaml
ENV LD_LIBRARY_PATH=/usr/lib
USER nonroot
ENTRYPOINT ["/app/provider"]
